# A background driver lets Bash process USR1 immediately during training.
# wait can be interrupted by the trap; keep waiting for the actual driver exit.
DRIVER_PID=$!
DRIVER_STATUS=0
while true; do
    wait "$DRIVER_PID" && DRIVER_STATUS=0 || DRIVER_STATUS=$?
    if ! kill -0 "$DRIVER_PID" 2>/dev/null; then break; fi
done
if (( DRIVER_STATUS != 0 )); then exit "$DRIVER_STATUS"; fi

echo "End time: $(date --iso-8601=seconds)"
