#!/usr/bin/env bash
# Leonardo curriculum OPD: two nodes, four A100 GPUs per node.
# Submit from the login node: bash curriculum-opd {stage1|stage2|stage3}
# DRY_RUN=1 validates paths/configuration without submitting.
# Later stages require a separately merged Hugging Face model.
#SBATCH --job-name=curriculum-opd
#SBATCH --account=AIFAC_S07_051
#SBATCH --partition=boost_usr_prod
#SBATCH --nodes=2
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:a100:4
#SBATCH --cpus-per-task=32
#SBATCH --mem=480G
#SBATCH --time=24:00:00
#SBATCH --signal=B:USR1@1200

set -euo pipefail

STAGE=${1:-${STAGE:-}}
case "$STAGE" in
    stage1)
        DEFAULT_ACTOR_MODEL_NAME=Qwen3-1.7B
        DEFAULT_REWARD_MODEL_NAME=Qwen3-4B
        ;;
    stage2)
        DEFAULT_ACTOR_MODEL_NAME=Qwen3-1.7B-OPD-4B
        DEFAULT_REWARD_MODEL_NAME=Qwen3-8B
        ;;
    stage3)
        DEFAULT_ACTOR_MODEL_NAME=Qwen3-1.7B-OPD-4B-8B
        DEFAULT_REWARD_MODEL_NAME=Qwen3-14B
        ;;
    *)
        echo "Usage: bash curriculum-opd {stage1|stage2|stage3}" >&2
        exit 2
        ;;
esac
ACTOR_MODEL_NAME=${ACTOR_MODEL_NAME:-$DEFAULT_ACTOR_MODEL_NAME}
REWARD_MODEL_NAME=${REWARD_MODEL_NAME:-$DEFAULT_REWARD_MODEL_NAME}

PROJECT_DIR=${PROJECT_DIR:-/leonardo_work/EUHPC_D33_157/OPD-experiment/OPD}
CONDA_BASE=/leonardo/home/userexternal/jbi00000/miniconda3
OPD_ENV=/leonardo_work/EUHPC_D33_157/jbi00000/conda_envs/opd-cu118
MODEL_ROOT=${MODEL_ROOT:-$PROJECT_DIR/model}
OPD_CACHE_ROOT=${OPD_CACHE_ROOT:-/leonardo_work/EUHPC_D33_157/OPD-experiment/.cache/opd}
EXPERIMENT_ROOT=${EXPERIMENT_ROOT:-$PROJECT_DIR/experiments}

# The curriculum labels define run names. The actual model locations remain
# overridable so a verified merged checkpoint can be stored elsewhere without
# changing the experiment identity.
ACTOR_MODEL_PATH=${ACTOR_MODEL_PATH:-$MODEL_ROOT/$ACTOR_MODEL_NAME}
REWARD_MODEL_PATH=${REWARD_MODEL_PATH:-$MODEL_ROOT/$REWARD_MODEL_NAME}

TRAIN_DATASET=$PROJECT_DIR/datasets/dapo-math-17k.parquet
TRAIN_DATASET_NAME=DAPO-Math-17k
TEST_DATASET='["'$PROJECT_DIR'/datasets/test_data/AIME25/test.parquet","'$PROJECT_DIR'/datasets/test_data/AMC23/test.parquet","'$PROJECT_DIR'/datasets/test_data/AIME24/test.parquet"]'

# These behavior-changing controls are intentionally identical to the Alex
# curriculum launcher, except rollout n=2 and checkpoint saving every 100 steps.
MAX_PROMPT_LENGTH=${MAX_PROMPT_LENGTH:-1024}
MAX_RESP_LENGTH=${MAX_RESP_LENGTH:-15360}
MAX_VAL_RESP_LENGTH=${MAX_VAL_RESP_LENGTH:-15360}
MINI_BATCH_SIZE=${MINI_BATCH_SIZE:-32}
N_RESPONSES=${N_RESPONSES:-2}
PARALLEL_SIZE=${PARALLEL_SIZE:-1}
MODEL_DTYPE=${MODEL_DTYPE:-bfloat16}
ROLLOUT_GPU_MEMORY_UTILIZATION=${ROLLOUT_GPU_MEMORY_UTILIZATION:-0.45}
ROLLOUT_ENFORCE_EAGER=${ROLLOUT_ENFORCE_EAGER:-True}
CUDAGRAPH_CAPTURE_SIZES=${CUDAGRAPH_CAPTURE_SIZES:-null}
PPO_MAX_TOKEN_LEN_PER_GPU=${PPO_MAX_TOKEN_LEN_PER_GPU:-16384}
REWARD_MODEL_MICRO_BATCH_SIZE=${REWARD_MODEL_MICRO_BATCH_SIZE:-1}
TRAINER_NNODES=2
TRAINER_SAVE_FREQ=${TRAINER_SAVE_FREQ:-100}
TRAINER_MAX_ACTOR_CKPT_TO_KEEP=${TRAINER_MAX_ACTOR_CKPT_TO_KEEP:-3}
TRAINER_MAX_CRITIC_CKPT_TO_KEEP=${TRAINER_MAX_CRITIC_CKPT_TO_KEEP:-3}
TRAINER_PROTECTED_CHECKPOINT_STEPS=${TRAINER_PROTECTED_CHECKPOINT_STEPS:-'[200,400,600]'}
TRAINER_TEST_FREQ=${TRAINER_TEST_FREQ:--1}
TRAINER_TOTAL_EPOCHS=${TRAINER_TOTAL_EPOCHS:-2}
TRAINER_RESUME_MODE=${TRAINER_RESUME_MODE:-auto}
TRAINER_LOGGER=${TRAINER_LOGGER:-'["console","wandb"]'}
TRAINER_IS_PLOT=${TRAINER_IS_PLOT:-False}
TRAIN_MAX_SAMPLES=${TRAIN_MAX_SAMPLES:-14336}
DATA_SHUFFLE=${DATA_SHUFFLE:-True}
DATA_SEED=${DATA_SEED:-42}
TRAINER_TOTAL_TRAINING_STEPS=${TRAINER_TOTAL_TRAINING_STEPS:-null}
SBATCH_TIME=24:00:00
SBATCH_GPUS=4
SBATCH_CPUS=32
EXPERIMENT_SUFFIX=${EXPERIMENT_SUFFIX:-}

TRAINER_N_GPUS_PER_NODE=$SBATCH_GPUS

# Single-GPU, one-step smoke test in an existing interactive allocation.
# Reduce batch/length only for this test; isolate it from resumable main runs.
SMOKE=${SMOKE:-0}
if [[ "$SMOKE" == 1 ]]; then
    TRAINER_NNODES=1
    TRAINER_N_GPUS_PER_NODE=1
    SBATCH_GPUS=1
    SBATCH_CPUS=8
    SBATCH_TIME=01:00:00
    MINI_BATCH_SIZE=1
    MAX_RESP_LENGTH=512
    MAX_VAL_RESP_LENGTH=512
    PPO_MAX_TOKEN_LEN_PER_GPU=2048
    TRAIN_MAX_SAMPLES=8
    TRAINER_TOTAL_TRAINING_STEPS=1
    TRAINER_SAVE_FREQ=-1
    TRAINER_RESUME_MODE=disable
    ROLLOUT_GPU_MEMORY_UTILIZATION=0.25
    EXPERIMENT_SUFFIX="-smoke-1gpu-${SLURM_JOB_ID:-new}"
elif [[ "$SMOKE" != 0 ]]; then
    echo "SMOKE must be 0 or 1." >&2
    exit 2
fi

TEMPERATURE=${TEMPERATURE:-0.6}
TOP_P=${TOP_P:-0.95}
GENERATION_TOP_K=${GENERATION_TOP_K:-20}
TEACHER_TEMPERATURE=${TEACHER_TEMPERATURE:-1.0}
REPETITION_PENALTY=${REPETITION_PENALTY:-1.0}
LOG_PROB_TOP_K=${LOG_PROB_TOP_K:-16}
TOP_K_STRATEGY=${TOP_K_STRATEGY:-only_stu}
REWARD_WEIGHT_MODE=${REWARD_WEIGHT_MODE:-student_p}

MAX_MODEL_LEN=$((MAX_PROMPT_LENGTH + (MAX_RESP_LENGTH > MAX_VAL_RESP_LENGTH ? MAX_RESP_LENGTH : MAX_VAL_RESP_LENGTH)))
if (( PPO_MAX_TOKEN_LEN_PER_GPU < MAX_MODEL_LEN )); then
    echo "PPO_MAX_TOKEN_LEN_PER_GPU=$PPO_MAX_TOKEN_LEN_PER_GPU must be at least MAX_MODEL_LEN=$MAX_MODEL_LEN." >&2
    exit 1
fi

EXPERIMENT_NAME=${EXPERIMENT_NAME:-token_reward_direct_${TRAIN_DATASET_NAME}_curriculum-${STAGE}_${ACTOR_MODEL_NAME}_${REWARD_MODEL_NAME}_r${MAX_RESP_LENGTH}-T${TEMPERATURE}-n${N_RESPONSES}-genk${GENERATION_TOP_K}-topp${TOP_P}-opdk${LOG_PROB_TOP_K}-${TOP_K_STRATEGY}${EXPERIMENT_SUFFIX}}
CKPT_PATH=$EXPERIMENT_ROOT/checkpoints/$EXPERIMENT_NAME
VALIDATION_DIR=$EXPERIMENT_ROOT/validation/$EXPERIMENT_NAME
LOG_DIR=${LOG_DIR:-$EXPERIMENT_ROOT/logs}
WANDB_MODE=${WANDB_MODE:-offline}
WANDB_DIR=${WANDB_DIR:-$OPD_CACHE_ROOT/wandb}
WANDB_CACHE_DIR=${WANDB_CACHE_DIR:-$OPD_CACHE_ROOT/wandb-cache}
WANDB_CONFIG_DIR=${WANDB_CONFIG_DIR:-$OPD_CACHE_ROOT/wandb-config}
WANDB_DATA_DIR=${WANDB_DATA_DIR:-$OPD_CACHE_ROOT/wandb-data}
WANDB_ARTIFACT_DIR=${WANDB_ARTIFACT_DIR:-$OPD_CACHE_ROOT/wandb-artifacts}
WANDB_PROJECT=${WANDB_PROJECT:-OnPolicyDistillation}
WANDB_RUN_ID_FILE=${WANDB_RUN_ID_FILE:-$CKPT_PATH/wandb_run_id}

require_file() {
    if [[ ! -f "$1" ]]; then
        echo "Required file is missing: $1" >&2
        exit 1
    fi
}

require_dir() {
    if [[ ! -d "$1" ]]; then
        echo "Required directory is missing: $1" >&2
        exit 1
    fi
}

require_hf_model() {
    local model_dir=$1
    require_dir "$model_dir"
    require_file "$model_dir/config.json"
    if ! compgen -G "$model_dir/model*.safetensors" >/dev/null; then
        echo "Hugging Face model weights are missing from: $model_dir" >&2
        exit 1
    fi
}

require_dir "$PROJECT_DIR"
require_file "$CONDA_BASE/etc/profile.d/conda.sh"
require_file "$OPD_ENV/bin/python"
require_hf_model "$ACTOR_MODEL_PATH"
require_hf_model "$REWARD_MODEL_PATH"
require_file "$TRAIN_DATASET"
for task in AIME25 AMC23 AIME24; do
    require_file "$PROJECT_DIR/datasets/test_data/$task/test.parquet"
done

print_configuration() {
    echo "Leonardo curriculum OPD configuration"
    echo "  stage:         $STAGE"
    echo "  project:       $PROJECT_DIR"
    echo "  environment:   $OPD_ENV"
    echo "  student:       $ACTOR_MODEL_PATH"
    echo "  teacher:       $REWARD_MODEL_PATH"
    echo "  experiment:    $EXPERIMENT_NAME"
    echo "  checkpoints:   $CKPT_PATH"
    echo "  validation:    $VALIDATION_DIR"
    echo "  resources:     $TRAINER_NNODES nodes, $SBATCH_GPUS x A100 per node, $SBATCH_CPUS CPUs, time=$SBATCH_TIME"
    echo "  resume mode:   $TRAINER_RESUME_MODE"
    echo "  thinking:      enabled"
    echo "  lengths:       prompt=$MAX_PROMPT_LENGTH, train_response=$MAX_RESP_LENGTH, val_response=$MAX_VAL_RESP_LENGTH"
    echo "  sampling:      temperature=$TEMPERATURE, top_p=$TOP_P, top_k=$GENERATION_TOP_K"
    echo "  OPD support:   student top-$LOG_PROB_TOP_K ($TOP_K_STRATEGY), n=$N_RESPONSES"
    echo "  token budget:  max_model_len=$MAX_MODEL_LEN, PPO per GPU=$PPO_MAX_TOKEN_LEN_PER_GPU"
    echo "  vLLM graphs:   enforce_eager=$ROLLOUT_ENFORCE_EAGER, capture_sizes=$CUDAGRAPH_CAPTURE_SIZES"
    echo "  W&B:           mode=$WANDB_MODE, project=$WANDB_PROJECT"
    echo "  W&B run ID:    persisted in $WANDB_RUN_ID_FILE"
    echo "  checkpoint:    every $TRAINER_SAVE_FREQ steps, keep latest $TRAINER_MAX_ACTOR_CKPT_TO_KEEP"
    echo "  protected ckpt:$TRAINER_PROTECTED_CHECKPOINT_STEPS"
    echo "  train samples: $TRAIN_MAX_SAMPLES"
    echo "  data order:    shuffle=$DATA_SHUFFLE, seed=$DATA_SEED"
    echo "  total steps:   $TRAINER_TOTAL_TRAINING_STEPS"
}

print_configuration

if [[ ${DRY_RUN:-0} == 1 ]]; then
    echo "DRY_RUN=1: preflight completed; no Slurm job was submitted."
    exit 0
fi

if [[ "$WANDB_MODE" == online && -z ${WANDB_API_KEY:-} && ! -s "$HOME/.netrc" ]]; then
    echo "WANDB_MODE=online, but neither WANDB_API_KEY nor a non-empty $HOME/.netrc is available." >&2
    echo "Export WANDB_API_KEY in the login shell before submitting, or set WANDB_MODE=offline explicitly." >&2
    exit 1
fi

# Running this file with bash on a login node is the supported submission
# interface. Perform all cheap path checks before requesting eight GPUs.
if [[ -z ${SLURM_JOB_ID:-} ]]; then
    mkdir -p "$LOG_DIR"
    SCRIPT_PATH=$(realpath "$0")
    exec sbatch \
        --export=ALL \
        --nodes="$TRAINER_NNODES" \
        --ntasks="$TRAINER_NNODES" \
        --time="$SBATCH_TIME" \
        --gres="gpu:a100:$SBATCH_GPUS" \
        --cpus-per-task="$SBATCH_CPUS" \
        --job-name="curriculum-opd-$STAGE${EXPERIMENT_SUFFIX}" \
        --output="$LOG_DIR/%x-%j.out" \
        --error="$LOG_DIR/%x-%j.err" \
        "$SCRIPT_PATH" "$STAGE"
fi

if [[ ${SLURM_NNODES:-0} -ne "$TRAINER_NNODES" ]]; then
    echo "Expected $TRAINER_NNODES allocated nodes, got SLURM_NNODES=${SLURM_NNODES:-unset}." >&2
    exit 1
fi

# Conda activation hooks may read unset variables such as ADDR2LINE.
set +u
source "$CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$OPD_ENV"
set -u
cd "$PROJECT_DIR"

JOB_TMP_ROOT=/tmp/${SLURM_JOB_ID}.opd
RAY_TEMP_DIR=${RAY_TEMP_DIR:-$JOB_TMP_ROOT/ray}
OUTLINES_CACHE_DIR=${OUTLINES_CACHE_DIR:-$OPD_CACHE_ROOT/outlines/$EXPERIMENT_NAME-$SLURM_JOB_ID}
OPD_TIMEOUT_SAVE_MARKER=$LOG_DIR/save-before-time-limit-${SLURM_JOB_ID}
RUN_STAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="$LOG_DIR/$EXPERIMENT_NAME-$SLURM_JOB_ID-$RUN_STAMP.log"

mkdir -p \
    "$CKPT_PATH" \
    "$VALIDATION_DIR" \
    "$LOG_DIR" \
    "$WANDB_DIR" \
    "$WANDB_CACHE_DIR" \
    "$WANDB_CONFIG_DIR" \
    "$WANDB_DATA_DIR" \
    "$WANDB_ARTIFACT_DIR" \
    "$OPD_CACHE_ROOT/triton" \
    "$OPD_CACHE_ROOT/torchinductor" \
    "$OPD_CACHE_ROOT/torch-extensions" \
    "$OPD_CACHE_ROOT/huggingface/datasets" \
    "$OPD_CACHE_ROOT/huggingface/hub" \
    "$OPD_CACHE_ROOT/flashinfer-workspace" \
    "$OPD_CACHE_ROOT/vllm-config" \
    "$OPD_CACHE_ROOT/vllm-cache" \
    "$OPD_CACHE_ROOT/xdg-config" \
    "$OPD_CACHE_ROOT/xdg-cache" \
    "$OPD_CACHE_ROOT/numba" \
    "$OPD_CACHE_ROOT/cuda" \
    "$OPD_CACHE_ROOT/verl-rlhf" \
    "$RAY_TEMP_DIR" \
    "$OUTLINES_CACHE_DIR" \
    "$JOB_TMP_ROOT"

exec 9>"$EXPERIMENT_ROOT/.lock-$EXPERIMENT_NAME"
if ! flock -n 9; then
    echo "Another $EXPERIMENT_NAME launcher already holds the experiment lock." >&2
    exit 1
fi

# Keep W&B on one run across Slurm interruption and checkpoint auto-resume.
if [[ -s "$WANDB_RUN_ID_FILE" ]]; then
    SAVED_WANDB_RUN_ID=$(<"$WANDB_RUN_ID_FILE")
    if [[ -n ${WANDB_RUN_ID:-} && "$WANDB_RUN_ID" != "$SAVED_WANDB_RUN_ID" ]]; then
        echo "WANDB_RUN_ID=$WANDB_RUN_ID conflicts with saved run ID $SAVED_WANDB_RUN_ID." >&2
        exit 1
    fi
    WANDB_RUN_ID=$SAVED_WANDB_RUN_ID
else
    # Avoid wandb.util.generate_id: it was removed in newer W&B releases.
    # An eight-character hexadecimal identifier satisfies W&B's run-ID rules
    # and remains stable because it is persisted beside the checkpoints.
    WANDB_RUN_ID=${WANDB_RUN_ID:-$(python -c 'import secrets; print(secrets.token_hex(4))')}
    printf '%s\n' "$WANDB_RUN_ID" > "$WANDB_RUN_ID_FILE"
fi

export PATH="$OPD_ENV/bin:$PATH"
export PYTHONPATH="$PROJECT_DIR/verl${PYTHONPATH:+:$PYTHONPATH}"
export TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-8.0}
export TMPDIR="$JOB_TMP_ROOT"
export EXPECTED_GPU_COUNT=$TRAINER_N_GPUS_PER_NODE

export HF_HOME="$OPD_CACHE_ROOT/huggingface"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_CACHE="$HF_HOME/hub"
export TRITON_CACHE_DIR="$OPD_CACHE_ROOT/triton"
export TORCHINDUCTOR_CACHE_DIR="$OPD_CACHE_ROOT/torchinductor"
export TORCH_EXTENSIONS_DIR="$OPD_CACHE_ROOT/torch-extensions"
export FLASHINFER_WORKSPACE_BASE="$OPD_CACHE_ROOT/flashinfer-workspace"
export VLLM_CONFIG_ROOT="$OPD_CACHE_ROOT/vllm-config"
export VLLM_CACHE_ROOT="$OPD_CACHE_ROOT/vllm-cache"
export XDG_CONFIG_HOME="$OPD_CACHE_ROOT/xdg-config"
export XDG_CACHE_HOME="$OPD_CACHE_ROOT/xdg-cache"
export NUMBA_CACHE_DIR="$OPD_CACHE_ROOT/numba"
export CUDA_CACHE_PATH="$OPD_CACHE_ROOT/cuda"
export OUTLINES_CACHE_DIR

export VLLM_NO_USAGE_STATS=1
export VLLM_DO_NOT_TRACK=1
export DO_NOT_TRACK=1
unset VLLM_ENABLE_V1_MULTIPROCESSING

export WANDB_MODE
export WANDB_DIR
export WANDB_CACHE_DIR
export WANDB_CONFIG_DIR
export WANDB_DATA_DIR
export WANDB_ARTIFACT_DIR
export WANDB_RUN_ID
export WANDB_RESUME=${WANDB_RESUME:-allow}

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=true
export HYDRA_FULL_ERROR=1
export NCCL_DEBUG=${NCCL_DEBUG:-WARN}
export NCCL_TIMEOUT=${NCCL_TIMEOUT:-7200}
export TORCH_NCCL_BLOCKING_WAIT=1
export TORCH_DISTRIBUTED_DEBUG=${TORCH_DISTRIBUTED_DEBUG:-OFF}
export CUDA_LAUNCH_BLOCKING=${CUDA_LAUNCH_BLOCKING:-0}
export RAY_memory_usage_threshold=0.99
export RAY_DEDUP_LOGS=0
export RAY_TEMP_DIR
export OPD_TIMEOUT_SAVE_MARKER

unset ROCR_VISIBLE_DEVICES

save_before_time_limit() {
    echo "$(date --iso-8601=seconds): received Slurm USR1; requesting a checkpoint at the next safe trainer-step boundary."
    touch "$OPD_TIMEOUT_SAVE_MARKER"
}
trap save_before_time_limit USR1

exec > >(tee -a "$LOG_FILE") 2>&1

record_job_exit() {
    local status=$?
    trap - EXIT
    if declare -F cleanup >/dev/null; then cleanup; fi
    if (( status == 0 )); then
        echo "Job exit: SUCCESS (code 0) at $(date --iso-8601=seconds)"
    else
        echo "Job exit: FAILURE (code $status) at $(date --iso-8601=seconds)" >&2
        echo "Inspect the full training log: $LOG_FILE" >&2
        echo "Inspect Slurm logs: $LOG_DIR/curriculum-opd-$STAGE-$SLURM_JOB_ID.out and .err" >&2
    fi
    exit "$status"
}
trap record_job_exit EXIT

echo "Start time: $(date --iso-8601=seconds)"
echo "Slurm job: $SLURM_JOB_ID on $SLURM_JOB_NODELIST"
echo "Log file: $LOG_FILE"
echo "W&B run: project=$WANDB_PROJECT, id=$WANDB_RUN_ID, mode=$WANDB_MODE, resume=$WANDB_RESUME"
mapfile -t NODES < <(scontrol show hostnames "$SLURM_JOB_NODELIST")
HEAD_NODE=${NODES[0]}
RAY_INIT_ARGS=("ray_kwargs.ray_init.num_cpus=null")
if [[ "$SMOKE" == 1 ]]; then
    unset RAY_ADDRESS
    RAY_INIT_ARGS=("ray_kwargs.ray_init.num_cpus=$SBATCH_CPUS" "+ray_kwargs.ray_init._temp_dir=$RAY_TEMP_DIR")
else
HEAD_IP=$(srun --nodes=1 --ntasks=1 -w "$HEAD_NODE" hostname --ip-address)

if [[ "$HEAD_IP" == *" "* ]]; then
    read -r -a IP_PARTS <<<"$HEAD_IP"
    if [[ ${#IP_PARTS[0]} -gt 16 ]]; then
        HEAD_IP=${IP_PARTS[1]}
    else
        HEAD_IP=${IP_PARTS[0]}
    fi
fi

RAY_PORT=6379
export RAY_ADDRESS="$HEAD_IP:$RAY_PORT"

cleanup() {
    srun --overlap --nodes="$SLURM_NNODES" --ntasks="$SLURM_NTASKS" \
        --ntasks-per-node=1 ray stop --force || true
}


echo "Job ID: ${SLURM_JOB_ID}"
echo "Allocated nodes: ${SLURM_JOB_NODELIST}"
echo "Ray head: ${RAY_ADDRESS}"

srun --overlap --nodes=1 --ntasks=1 -w "$HEAD_NODE" \
    env -u ROCR_VISIBLE_DEVICES ray start --head --node-ip-address="$HEAD_IP" --port="$RAY_PORT" \
    --num-cpus="$SLURM_CPUS_PER_TASK" --num-gpus=4 --block &
sleep 10

for ((NODE_INDEX = 1; NODE_INDEX < ${#NODES[@]}; NODE_INDEX++)); do
    WORKER_NODE=${NODES[$NODE_INDEX]}
    srun --overlap --nodes=1 --ntasks=1 -w "$WORKER_NODE" \
        env -u ROCR_VISIBLE_DEVICES ray start --address="$RAY_ADDRESS" --num-cpus="$SLURM_CPUS_PER_TASK" \
        --num-gpus=4 --block &
    sleep 5
done
RAY_INIT_ARGS+=("+ray_kwargs.ray_init.address=$RAY_ADDRESS")
fi

# Check both allocated nodes using the activated Leonardo environment.
srun --overlap --nodes="$TRAINER_NNODES" --ntasks="$TRAINER_NNODES" --ntasks-per-node=1 bash -ec '
    python --version
    python -m pip check
    nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
'
srun --overlap --nodes=1 --ntasks=1 -w "$HEAD_NODE" \
    python -m verl.trainer.main_ppo \
    "algorithm.adv_estimator=token_reward_direct" \
    "algorithm.grpo_outcome_weight=1.0" \
    "data.shuffle=$DATA_SHUFFLE" \
    "data.seed=$DATA_SEED" \
    "+data.cache_dir=$OPD_CACHE_ROOT/verl-rlhf" \
    "data.train_files=$TRAIN_DATASET" \
    "data.train_max_samples=$TRAIN_MAX_SAMPLES" \
    "data.val_files=$TEST_DATASET" \
    "data.train_batch_size=$MINI_BATCH_SIZE" \
    "data.max_prompt_length=$MAX_PROMPT_LENGTH" \
    "data.max_response_length=$MAX_RESP_LENGTH" \
    "data.filter_overlong_prompts=True" \
    "data.truncation=error" \
    "data.return_raw_chat=True" \
    "+data.apply_chat_template_kwargs.enable_thinking=True" \
    "actor_rollout_ref.model.path=$ACTOR_MODEL_PATH" \
    "actor_rollout_ref.model.use_remove_padding=True" \
    "actor_rollout_ref.model.enable_activation_offload=True" \
    "actor_rollout_ref.model.enable_gradient_checkpointing=True" \
    "actor_rollout_ref.actor.optim.lr=1e-6" \
    "actor_rollout_ref.actor.ppo_mini_batch_size=$MINI_BATCH_SIZE" \
    "actor_rollout_ref.actor.use_dynamic_bsz=True" \
    "actor_rollout_ref.actor.use_torch_compile=False" \
    "actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1" \
    "actor_rollout_ref.actor.ppo_max_token_len_per_gpu=$PPO_MAX_TOKEN_LEN_PER_GPU" \
    "actor_rollout_ref.actor.ulysses_sequence_parallel_size=$PARALLEL_SIZE" \
    "actor_rollout_ref.actor.entropy_from_logits_with_chunking=True" \
    "actor_rollout_ref.actor.use_kl_loss=False" \
    "actor_rollout_ref.actor.loss_agg_mode=token-mean" \
    "actor_rollout_ref.actor.fsdp_config.param_offload=False" \
    "actor_rollout_ref.actor.fsdp_config.optimizer_offload=False" \
    "actor_rollout_ref.actor.fsdp_config.forward_prefetch=True" \
    "actor_rollout_ref.actor.fsdp_config.model_dtype=$MODEL_DTYPE" \
    "+actor_rollout_ref.actor.checkpoint.protected_global_steps=$TRAINER_PROTECTED_CHECKPOINT_STEPS" \
    "actor_rollout_ref.rollout.max_num_batched_tokens=$PPO_MAX_TOKEN_LEN_PER_GPU" \
    "actor_rollout_ref.ref.fsdp_config.param_offload=True" \
    "actor_rollout_ref.ref.fsdp_config.model_dtype=$MODEL_DTYPE" \
    "actor_rollout_ref.ref.log_prob_use_dynamic_bsz=True" \
    "actor_rollout_ref.rollout.name=vllm" \
    "actor_rollout_ref.rollout.enforce_eager=$ROLLOUT_ENFORCE_EAGER" \
