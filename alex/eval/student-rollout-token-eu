#!/usr/bin/env bash
# Score saved student evaluation text with student self-EU or Qwen3-4B/8B/14B EU.
# No student generation or training occurs. Scoring models run sequentially on one GPU.

#SBATCH --job-name=eval-student-token-eu
#SBATCH --partition=a100
#SBATCH --constraint=a100_80
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00

set -euo pipefail

if [[ -z ${OPD_WS:-} ]]; then
    command -v ws_find >/dev/null 2>&1 || {
        echo "Run on Alex or set OPD_WS explicitly." >&2
        exit 1
    }
    OPD_WS=$(ws_find opd)
fi

PROJECT_DIR=${PROJECT_DIR:-$OPD_WS/OPD}
OPD_ENV=${OPD_ENV:-$OPD_WS/envs/opd-py312}
MODEL_ROOT=${MODEL_ROOT:-$OPD_WS/models}
EXPERIMENT_ROOT=${EXPERIMENT_ROOT:-$OPD_WS/experiments/OPD}
OPD_CACHE_ROOT=${OPD_CACHE_ROOT:-$OPD_WS/.cache/opd}
LOG_DIR=${LOG_DIR:-$EXPERIMENT_ROOT/logs}

SOURCE_EVALUATION_ROOT=${SOURCE_EVALUATION_ROOT:-$EXPERIMENT_ROOT/evaluation/Qwen3-1.7B-OPD-dynamic-LN-b0.0-tau0.1-nonthinking-r7680-step894-nonthinking-official-t0.7-p0.8-topk20-minp0.0-mnt38912-n16}
TASK=${TASK:-AMC23}
MODEL_LABEL=${MODEL_LABEL:-Qwen3-1.7B-OPD-dynamic-LN-b0.0-tau0.1-nonthinking-r7680-step894}
STUDENT_MODEL_PATH=${STUDENT_MODEL_PATH:-}
TEACHER4B_PATH=${TEACHER4B_PATH:-$MODEL_ROOT/Qwen3-4B}
TEACHER8B_PATH=${TEACHER8B_PATH:-$MODEL_ROOT/Qwen3-8B}
TEACHER14B_PATH=${TEACHER14B_PATH:-$MODEL_ROOT/Qwen3-14B}
EXAMPLE_IDS=${EXAMPLE_IDS:-}
SCORE_CHUNK_SIZE=${SCORE_CHUNK_SIZE:-128}
MAX_TRAJECTORIES=${MAX_TRAJECTORIES:-0}
PLOT_TRAJECTORIES=${PLOT_TRAJECTORIES:-"index:0"}
HIGH_TOKEN_TOP_N=${HIGH_TOKEN_TOP_N:-20}
SBATCH_TIME=${SBATCH_TIME:-24:00:00}
JOB_NAME=${JOB_NAME:-eval-student-token-eu}

if [[ -z ${EU_OUTPUT_ROOT:-} ]]; then
    if [[ -n "$STUDENT_MODEL_PATH" ]]; then
        EU_OUTPUT_ROOT=$EXPERIMENT_ROOT/evaluation/student-self-eu-${MODEL_LABEL}-${TASK,,}-$(date +%Y%m%d-%H%M%S)
    else
        EU_OUTPUT_ROOT=$EXPERIMENT_ROOT/evaluation/teacher-token-eu-${MODEL_LABEL}-${TASK,,}-$(date +%Y%m%d-%H%M%S)
    fi
fi

CORE_SCRIPT=$PROJECT_DIR/scripts/val/eval/eval_student_rollout_eu.py
BASE_SCORER=$PROJECT_DIR/scripts/val/eval/eval_token_eu.py
EU_UTILITY=$PROJECT_DIR/verl/verl/utils/epistemic_uncertainty.py

require_file() {
    [[ -f "$1" ]] || { echo "Required file missing: $1" >&2; exit 1; }
}

require_model() {
    [[ "$1" == /* && -f "$1/config.json" ]] || {
        echo "Expected an absolute Hugging Face model directory: $1" >&2
        exit 1
    }
    compgen -G "$1/model*.safetensors" >/dev/null || {
        echo "Model weights missing from: $1" >&2
        exit 1
    }
}

require_file "$OPD_ENV/bin/activate"
require_file "$SOURCE_EVALUATION_ROOT/evaluation_config.json"
require_file "$CORE_SCRIPT"
require_file "$BASE_SCORER"
require_file "$EU_UTILITY"
if [[ -n "$STUDENT_MODEL_PATH" ]]; then
    require_model "$STUDENT_MODEL_PATH"
else
    require_model "$TEACHER4B_PATH"
    require_model "$TEACHER8B_PATH"
    require_model "$TEACHER14B_PATH"
fi
[[ "$EU_OUTPUT_ROOT" == /* && ! -e "$EU_OUTPUT_ROOT" ]] || {
    echo "EU_OUTPUT_ROOT must be a new absolute path: $EU_OUTPUT_ROOT" >&2
    exit 1
}
[[ "$MAX_TRAJECTORIES" =~ ^[0-9]+$ ]] || {
    echo "MAX_TRAJECTORIES must be a nonnegative integer." >&2
    exit 2
}

read -r -a PLOT_SPECS <<< "$PLOT_TRAJECTORIES"
ARGS=(
    --evaluation-root "$SOURCE_EVALUATION_ROOT"
    --model-label "$MODEL_LABEL"
    --task "$TASK"
    --output-root "$EU_OUTPUT_ROOT"
    --score-chunk-size "$SCORE_CHUNK_SIZE"
    --max-trajectories "$MAX_TRAJECTORIES"
    --high-token-top-n "$HIGH_TOKEN_TOP_N"
)
if [[ -n "$STUDENT_MODEL_PATH" ]]; then
    ARGS+=(--student-model "$STUDENT_MODEL_PATH")
else
    ARGS+=(--teacher-4b "$TEACHER4B_PATH" --teacher-8b "$TEACHER8B_PATH" --teacher-14b "$TEACHER14B_PATH")
fi
read -r -a SELECTED_EXAMPLE_IDS <<< "$EXAMPLE_IDS"
for example_id in "${SELECTED_EXAMPLE_IDS[@]}"; do
    [[ "$example_id" =~ ^[0-9]+$ ]] || { echo "EXAMPLE_IDS must contain nonnegative integers." >&2; exit 2; }
    ARGS+=(--example-id "$example_id")
done
for spec in "${PLOT_SPECS[@]}"; do
    ARGS+=(--plot-trajectory "$spec")
done

echo "Alex student-rollout token EU configuration"
echo "  source evaluation: $SOURCE_EVALUATION_ROOT"
echo "  task/model:        $TASK / $MODEL_LABEL"
if [[ -n "$STUDENT_MODEL_PATH" ]]; then
    echo "  scoring mode:      student self-EU"
    echo "  student model:     $STUDENT_MODEL_PATH"
else
    echo "  scoring mode:      three teachers"
    echo "  teachers:          $TEACHER4B_PATH, $TEACHER8B_PATH, $TEACHER14B_PATH"
fi
echo "  output:            $EU_OUTPUT_ROOT"
echo "  example IDs:       ${EXAMPLE_IDS:-all}"
echo "  trajectories:      ${MAX_TRAJECTORIES} (0 means all)"
echo "  plotted:           $PLOT_TRAJECTORIES"
echo "  high-token top-N:  $HIGH_TOKEN_TOP_N per teacher and trajectory"
echo "  score chunk:       $SCORE_CHUNK_SIZE"
echo "  resources:         1 x A100-80GB, 8 CPUs, time=$SBATCH_TIME"
echo "  operation:         reconstruct visible saved text; no generation or training"

source "$OPD_ENV/bin/activate"
python "$CORE_SCRIPT" "${ARGS[@]}" --dry-run

if [[ ${DRY_RUN:-0} == 1 ]]; then
    echo "DRY_RUN=1: input/model/tokenizer preflight passed; no job submitted."
    exit 0
fi

if [[ -z ${SLURM_JOB_ID:-} ]]; then
    mkdir -p "$LOG_DIR"
    export OPD_WS PROJECT_DIR OPD_ENV MODEL_ROOT EXPERIMENT_ROOT OPD_CACHE_ROOT LOG_DIR
    export SOURCE_EVALUATION_ROOT TASK MODEL_LABEL STUDENT_MODEL_PATH
    export TEACHER4B_PATH TEACHER8B_PATH TEACHER14B_PATH EXAMPLE_IDS
    export SCORE_CHUNK_SIZE MAX_TRAJECTORIES PLOT_TRAJECTORIES HIGH_TOKEN_TOP_N
    export EU_OUTPUT_ROOT SBATCH_TIME JOB_NAME
    exec sbatch \
        --export=ALL \
        --time="$SBATCH_TIME" \
        --job-name="$JOB_NAME" \
        --output="$LOG_DIR/%x-%j.out" \
        --error="$LOG_DIR/%x-%j.err" \
        "$(realpath "$0")"
fi

module purge
module load cuda/12.8.1
source "$OPD_ENV/bin/activate"

if [[ ! ${CUDA_VISIBLE_DEVICES:-} =~ ^[0-9]+$ ]]; then
    echo "Expected exactly one numeric Slurm GPU ID, got: ${CUDA_VISIBLE_DEVICES:-unset}" >&2
    exit 1
fi

export CUDA_HOME
CUDA_HOME=$(dirname "$(dirname "$(command -v nvcc)")")
export PATH="$OPD_ENV/bin:$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONPATH="$PROJECT_DIR/verl${PYTHONPATH:+:$PYTHONPATH}"
export TMPDIR=${TMPDIR:-/tmp/${SLURM_JOB_ID}.student-token-eu}
export HF_HOME="$OPD_CACHE_ROOT/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_HUB_OFFLINE=1
export XDG_CACHE_HOME="$OPD_CACHE_ROOT/xdg-cache"
export TRITON_CACHE_DIR="$OPD_CACHE_ROOT/triton"
export TORCHINDUCTOR_CACHE_DIR="$OPD_CACHE_ROOT/torchinductor"
export TORCH_EXTENSIONS_DIR="$OPD_CACHE_ROOT/torch-extensions"
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1
unset ROCR_VISIBLE_DEVICES

mkdir -p "$TMPDIR" "$HF_HUB_CACHE" "$XDG_CACHE_HOME" "$TRITON_CACHE_DIR" \
    "$TORCHINDUCTOR_CACHE_DIR" "$TORCH_EXTENSIONS_DIR"
cd "$PROJECT_DIR"

echo "Start: $(date --iso-8601=seconds), job=$SLURM_JOB_ID, node=${SLURM_JOB_NODELIST:-unknown}"
python --version
python -m pip check
nvidia-smi --query-gpu=index,name,memory.total,memory.used,utilization.gpu --format=csv,noheader
exec python "$CORE_SCRIPT" "${ARGS[@]}"
