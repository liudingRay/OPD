#!/usr/bin/env bash
# Fixed-question overlap evaluation, identical scientific settings to puhui's
# eval-curriculum-overlap. Shared implementation: scripts/val/eval/eval_fixed_overlap.py.
# Login-node interface: bash alex/eval-curriculum-overlap
# Preflight only: DRY_RUN=1 bash alex/eval-curriculum-overlap
# No training, backward pass, checkpoint merging, or output replacement.
# PAIR_SET=all evaluates the three stage-final pairs. PAIR_SET=curriculum_starts
# evaluates only the Stage-2 and Stage-3 starting checkpoints against their new
# teachers. PAIR_SET=official_student_teachers compares one official 1.7B
# trajectory set with all three teachers. PAIR_SET=direct_opd_students evaluates
# three independent 1.7B students trained directly with 4B/8B/14B teachers.
# PAIR_SET=multiteacher_student_teachers compares one explicitly selected
# multi-teacher student with all three teachers while reusing its trajectories.
# Model paths use the confirmed Alex layout and remain overridable.

#SBATCH --job-name=eval-curriculum-overlap
#SBATCH --partition=a100
#SBATCH --constraint=a100_80
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00

set -euo pipefail

if [[ -z ${OPD_WS:-} ]]; then
    if ! command -v ws_find >/dev/null 2>&1; then
        echo "Run on Alex with ws_find available, or set OPD_WS explicitly." >&2
        exit 1
    fi
    OPD_WS=$(ws_find opd)
fi
[[ -n "$OPD_WS" && -d "$OPD_WS" ]] || { echo "Invalid OPD workspace: $OPD_WS" >&2; exit 1; }
PROJECT_DIR=${PROJECT_DIR:-$OPD_WS/OPD}
OPD_ENV=${OPD_ENV:-$OPD_WS/envs/opd-py312}
MODEL_ROOT=${MODEL_ROOT:-$OPD_WS/models}
EXPERIMENT_ROOT=${EXPERIMENT_ROOT:-$OPD_WS/experiments/OPD}
OPD_CACHE_ROOT=${OPD_CACHE_ROOT:-$OPD_WS/.cache/opd}
DATA_DIR=${DATA_DIR:-$PROJECT_DIR/scripts/val/data}
LOG_DIR=${LOG_DIR:-$EXPERIMENT_ROOT/logs}
PAIR_SET=${PAIR_SET:-all}
ENABLE_THINKING=${ENABLE_THINKING:-0}
case "$ENABLE_THINKING" in
    1|true|True|TRUE) THINKING_LABEL=thinking ;;
    0|false|False|FALSE) THINKING_LABEL=nonthinking ;;
    *)
        echo "ENABLE_THINKING must be one of: 1, true, 0, false; got: $ENABLE_THINKING" >&2
        exit 2
        ;;
esac

# Export at submission so the allocation uses the same selected model paths.
STAGE1_MODEL_PATH=${STAGE1_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B}
STAGE2_MODEL_PATH=${STAGE2_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B-8B}
STAGE3_MODEL_PATH=${STAGE3_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B-8B-14B}
TEACHER4B_PATH=${TEACHER4B_PATH:-$MODEL_ROOT/Qwen3-4B}
TEACHER8B_PATH=${TEACHER8B_PATH:-$MODEL_ROOT/Qwen3-8B}
TEACHER14B_PATH=${TEACHER14B_PATH:-$MODEL_ROOT/Qwen3-14B}
STAGE2_START_MODEL_PATH=${STAGE2_START_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B-quick80-step280}
STAGE3_START_MODEL_PATH=${STAGE3_START_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B-8B-quick80-step280}
OFFICIAL_STUDENT_PATH=${OFFICIAL_STUDENT_PATH:-$MODEL_ROOT/Qwen3-1.7B}
DIRECT_OPD4B_PATH=${DIRECT_OPD4B_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B-quick80-step280}
DIRECT_OPD8B_PATH=${DIRECT_OPD8B_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-8B-quick80-step300}
DIRECT_OPD14B_PATH=${DIRECT_OPD14B_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-14B-quick80-step300}
MULTITEACHER_STUDENT_PATH=${MULTITEACHER_STUDENT_PATH:-}
MULTITEACHER_STUDENT_LABEL=${MULTITEACHER_STUDENT_LABEL:-multiteacher_student}

case "$PAIR_SET" in
    all)
        DEFAULT_OUTPUT_NAME=curriculum-overlap-fixed
        PAIR_ARGS=(
            --pair "stage1=$STAGE1_MODEL_PATH,$TEACHER4B_PATH"
            --pair "stage2=$STAGE2_MODEL_PATH,$TEACHER8B_PATH"
            --pair "stage3=$STAGE3_MODEL_PATH,$TEACHER14B_PATH"
        )
        MODELS_TO_VALIDATE=(
            "$STAGE1_MODEL_PATH" "$STAGE2_MODEL_PATH" "$STAGE3_MODEL_PATH"
            "$TEACHER4B_PATH" "$TEACHER8B_PATH" "$TEACHER14B_PATH"
        )
        ;;
    curriculum_starts)
        DEFAULT_OUTPUT_NAME=curriculum-overlap-fixed-stage-starts
        PAIR_ARGS=(
            --pair "stage2_start=$STAGE2_START_MODEL_PATH,$TEACHER8B_PATH"
            --pair "stage3_start=$STAGE3_START_MODEL_PATH,$TEACHER14B_PATH"
        )
        MODELS_TO_VALIDATE=(
            "$STAGE2_START_MODEL_PATH" "$STAGE3_START_MODEL_PATH"
            "$TEACHER8B_PATH" "$TEACHER14B_PATH"
        )
        ;;
    official_student_teachers)
        DEFAULT_OUTPUT_NAME=official-qwen3-1p7b-overlap-fixed-teachers
        PAIR_ARGS=(
            --pair "official_1p7b_vs_4b=$OFFICIAL_STUDENT_PATH,$TEACHER4B_PATH"
            --pair "official_1p7b_vs_8b=$OFFICIAL_STUDENT_PATH,$TEACHER8B_PATH"
            --pair "official_1p7b_vs_14b=$OFFICIAL_STUDENT_PATH,$TEACHER14B_PATH"
            --reuse-trajectories "official_1p7b_vs_8b=official_1p7b_vs_4b"
            --reuse-trajectories "official_1p7b_vs_14b=official_1p7b_vs_4b"
        )
        MODELS_TO_VALIDATE=(
            "$OFFICIAL_STUDENT_PATH" "$TEACHER4B_PATH" "$TEACHER8B_PATH" "$TEACHER14B_PATH"
        )
        ;;
    direct_opd_students)
        DEFAULT_OUTPUT_NAME=direct-opd-overlap-fixed-student
        PAIR_ARGS=(
            --pair "direct_opd_4b=$DIRECT_OPD4B_PATH,$TEACHER4B_PATH"
            --pair "direct_opd_8b=$DIRECT_OPD8B_PATH,$TEACHER8B_PATH"
            --pair "direct_opd_14b=$DIRECT_OPD14B_PATH,$TEACHER14B_PATH"
        )
        MODELS_TO_VALIDATE=(
            "$DIRECT_OPD4B_PATH" "$DIRECT_OPD8B_PATH" "$DIRECT_OPD14B_PATH"
            "$TEACHER4B_PATH" "$TEACHER8B_PATH" "$TEACHER14B_PATH"
        )
        ;;
    multiteacher_student_teachers)
        [[ -n "$MULTITEACHER_STUDENT_PATH" ]] || {
            echo "MULTITEACHER_STUDENT_PATH is required for PAIR_SET=multiteacher_student_teachers" >&2
            exit 2
        }
        [[ "$MULTITEACHER_STUDENT_LABEL" =~ ^[A-Za-z0-9_.-]+$ ]] || {
            echo "MULTITEACHER_STUDENT_LABEL must contain only letters, digits, dot, underscore, or hyphen" >&2
            exit 2
        }
        DEFAULT_OUTPUT_NAME=${MULTITEACHER_STUDENT_LABEL}-overlap-fixed-teachers
        PAIR_ARGS=(
            --pair "${MULTITEACHER_STUDENT_LABEL}_vs_4b=$MULTITEACHER_STUDENT_PATH,$TEACHER4B_PATH"
            --pair "${MULTITEACHER_STUDENT_LABEL}_vs_8b=$MULTITEACHER_STUDENT_PATH,$TEACHER8B_PATH"
            --pair "${MULTITEACHER_STUDENT_LABEL}_vs_14b=$MULTITEACHER_STUDENT_PATH,$TEACHER14B_PATH"
            --reuse-trajectories "${MULTITEACHER_STUDENT_LABEL}_vs_8b=${MULTITEACHER_STUDENT_LABEL}_vs_4b"
            --reuse-trajectories "${MULTITEACHER_STUDENT_LABEL}_vs_14b=${MULTITEACHER_STUDENT_LABEL}_vs_4b"
        )
        MODELS_TO_VALIDATE=(
            "$MULTITEACHER_STUDENT_PATH" "$TEACHER4B_PATH" "$TEACHER8B_PATH" "$TEACHER14B_PATH"
        )
        ;;
    *)
        echo "PAIR_SET must be all, curriculum_starts, official_student_teachers, direct_opd_students, or multiteacher_student_teachers; got: $PAIR_SET" >&2
        exit 2
        ;;
esac
DEFAULT_OUTPUT_NAME+=-$THINKING_LABEL
OVERLAP_OUTPUT_ROOT=${OVERLAP_OUTPUT_ROOT:-$EXPERIMENT_ROOT/evaluation/$DEFAULT_OUTPUT_NAME}

QUESTIONS_PER_TASK=${QUESTIONS_PER_TASK:-5}
SAMPLES_PER_QUESTION=${SAMPLES_PER_QUESTION:-1}
SEED=${SEED:-42}
MAX_TOKENS=${MAX_TOKENS:-38912}
TEMPERATURE=${TEMPERATURE:-0.7}
TOP_P=${TOP_P:-0.8}
GENERATION_TOP_K=${GENERATION_TOP_K:-20}
SCORE_CHUNK_SIZE=${SCORE_CHUNK_SIZE:-128}

require_file() {
    [[ -f "$1" ]] || { echo "Required file missing: $1" >&2; exit 1; }
}
require_file "$OPD_ENV/bin/activate"
require_file "$PROJECT_DIR/scripts/val/eval/eval_fixed_overlap.py"
for model in "${MODELS_TO_VALIDATE[@]}"; do
    [[ "$model" == /* ]] || { echo "Model path must be absolute: $model" >&2; exit 1; }
    require_file "$model/config.json"
    if ! compgen -G "$model/model*.safetensors" >/dev/null; then
        echo "Missing merged Hugging Face weights: $model" >&2
        exit 1
    fi
done
for task in AIME24 AIME25 AMC23; do
    require_file "$DATA_DIR/$task/test.parquet"
done
if [[ -e "$OVERLAP_OUTPUT_ROOT" ]]; then
    echo "Output already exists; choose a new OVERLAP_OUTPUT_ROOT: $OVERLAP_OUTPUT_ROOT" >&2
    exit 1
fi

ARGS=(
    "${PAIR_ARGS[@]}"
    --data-dir "$DATA_DIR" --output-root "$OVERLAP_OUTPUT_ROOT"
    --questions-per-task "$QUESTIONS_PER_TASK" --samples-per-question "$SAMPLES_PER_QUESTION" --seed "$SEED"
    --max-tokens "$MAX_TOKENS" --temperature "$TEMPERATURE" --top-p "$TOP_P"
    --generation-top-k "$GENERATION_TOP_K" --ks 4 8 16
    --score-chunk-size "$SCORE_CHUNK_SIZE"
)
if [[ "$THINKING_LABEL" == thinking ]]; then
    ARGS+=(--enable-thinking)
fi

module purge
module load cuda/12.8.1
source "$OPD_ENV/bin/activate"
export CUDA_HOME
CUDA_HOME=$(dirname "$(dirname "$(command -v nvcc)")")
export PATH="$OPD_ENV/bin:$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export HF_HOME="$OPD_CACHE_ROOT/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_OFFLINE=1
export TRITON_CACHE_DIR="$OPD_CACHE_ROOT/triton"
export TORCHINDUCTOR_CACHE_DIR="$OPD_CACHE_ROOT/torchinductor"
export TORCH_EXTENSIONS_DIR="$OPD_CACHE_ROOT/torch-extensions"
export FLASHINFER_WORKSPACE_BASE="$OPD_CACHE_ROOT/flashinfer-workspace"
export VLLM_CONFIG_ROOT="$OPD_CACHE_ROOT/vllm-config"
export VLLM_CACHE_ROOT="$OPD_CACHE_ROOT/vllm-cache"
export XDG_CONFIG_HOME="$OPD_CACHE_ROOT/xdg-config"
export XDG_CACHE_HOME="$OPD_CACHE_ROOT/xdg-cache"
export OUTLINES_CACHE_DIR="$OPD_CACHE_ROOT/outlines/overlap-${SLURM_JOB_ID:-preflight-$$}"
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export VLLM_NO_USAGE_STATS=1 VLLM_DO_NOT_TRACK=1 DO_NOT_TRACK=1
unset ROCR_VISIBLE_DEVICES

if [[ -z ${SLURM_JOB_ID:-} || ${DRY_RUN:-0} == 1 ]]; then
    # Shared CPU-only preflight validates sampling, tokenizers, context limits,
    # model paths, dataset fingerprints and deterministic selected questions.
    python "$PROJECT_DIR/scripts/val/eval/eval_fixed_overlap.py" "${ARGS[@]}" --dry-run
    if [[ ${DRY_RUN:-0} == 1 ]]; then
        echo "DRY_RUN=1: no Slurm job submitted and no GPU inference started."
        exit 0
    fi
    mkdir -p "$LOG_DIR"
    export OPD_WS PROJECT_DIR OPD_ENV MODEL_ROOT EXPERIMENT_ROOT OPD_CACHE_ROOT DATA_DIR LOG_DIR
    export PAIR_SET OVERLAP_OUTPUT_ROOT STAGE1_MODEL_PATH STAGE2_MODEL_PATH STAGE3_MODEL_PATH
    export STAGE2_START_MODEL_PATH STAGE3_START_MODEL_PATH
    export OFFICIAL_STUDENT_PATH DIRECT_OPD4B_PATH DIRECT_OPD8B_PATH DIRECT_OPD14B_PATH
    export MULTITEACHER_STUDENT_PATH MULTITEACHER_STUDENT_LABEL
    export TEACHER4B_PATH TEACHER8B_PATH TEACHER14B_PATH
    export QUESTIONS_PER_TASK SAMPLES_PER_QUESTION SEED MAX_TOKENS TEMPERATURE TOP_P GENERATION_TOP_K
    export ENABLE_THINKING
    export SCORE_CHUNK_SIZE
    JOB_NAME=${JOB_NAME:-eval-overlap-${PAIR_SET}-q${QUESTIONS_PER_TASK}-r${SAMPLES_PER_QUESTION}}
    exec sbatch --export=ALL --job-name="$JOB_NAME" \
        --output="$LOG_DIR/%x-%j.out" --error="$LOG_DIR/%x-%j.err" "$(realpath "$0")"
fi

# Preserve Slurm's selected GPU; never replace it with a physical GPU guess.
if [[ ! ${CUDA_VISIBLE_DEVICES:-} =~ ^[0-9]+$ ]]; then
    echo "Expected one numeric GPU ID in Slurm CUDA_VISIBLE_DEVICES; got: ${CUDA_VISIBLE_DEVICES:-unset}" >&2
    exit 1
fi
export TMPDIR=${TMPDIR:-/tmp/${SLURM_JOB_ID}.alex-overlap}
mkdir -p "$TMPDIR" "$HF_HUB_CACHE" "$HF_DATASETS_CACHE" "$TRITON_CACHE_DIR" \
    "$TORCHINDUCTOR_CACHE_DIR" "$TORCH_EXTENSIONS_DIR" "$FLASHINFER_WORKSPACE_BASE" \
    "$VLLM_CONFIG_ROOT" "$VLLM_CACHE_ROOT" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$OUTLINES_CACHE_DIR"
cd "$PROJECT_DIR"
echo "Start: $(date --iso-8601=seconds), job=$SLURM_JOB_ID, nodes=${SLURM_JOB_NODELIST:-unknown}"
echo "Output: $OVERLAP_OUTPUT_ROOT ($QUESTIONS_PER_TASK questions/task x $SAMPLES_PER_QUESTION responses/question)"
python --version
python -m pip check
nvidia-smi --query-gpu=index,name,memory.total,memory.used,utilization.gpu --format=csv,noheader
exec python "$PROJECT_DIR/scripts/val/eval/eval_fixed_overlap.py" "${ARGS[@]}"
