#!/usr/bin/env bash
# Single-node curriculum OPD launcher for the shared puhui 8 x H800 server.
#
# Usage (choose the configured number of currently idle physical GPU IDs explicitly):
#   CUDA_VISIBLE_DEVICES=0,1,4,5 bash puhui/curriculum-opd stage1
#   ACTOR_MODEL_PATH=/path/to/merged-stage1 \
#     CUDA_VISIBLE_DEVICES=0,1,4,5 bash puhui/curriculum-opd stage2
#   CUDA_VISIBLE_DEVICES=0,1,4,5 bash puhui/curriculum-opd stage3
#   CUDA_VISIBLE_DEVICES=0,1 bash puhui/curriculum-opd-cudagraph-smoke-2xh800 stage1
#
# Each stage consumes the separately merged Hugging Face model from the previous
# stage. This script trains only; it never merges a checkpoint. Set DRY_RUN=1 to
# validate paths/configuration without starting Ray or allocating a GPU.

set -euo pipefail

STAGE=${1:-${STAGE:-}}
SMOKE=${SMOKE:-0}
SMOKE_STEPS=${SMOKE_STEPS:-1}
case "$SMOKE" in
    0|1) ;;
    *)
        echo "SMOKE must be 0 or 1; got: $SMOKE" >&2
        exit 2
        ;;
esac
if [[ ! "$SMOKE_STEPS" =~ ^[1-9][0-9]*$ ]]; then
    echo "SMOKE_STEPS must be a positive integer; got: $SMOKE_STEPS" >&2
    exit 2
fi

case "$STAGE" in
    stage1)
        ACTOR_MODEL_NAME=Qwen3-1.7B
        REWARD_MODEL_NAME=Qwen3-4B
        ;;
    stage2)
        ACTOR_MODEL_NAME=Qwen3-1.7B-OPD-4B
        REWARD_MODEL_NAME=Qwen3-8B
        ;;
    stage3)
        ACTOR_MODEL_NAME=Qwen3-1.7B-OPD-4B-8B
        REWARD_MODEL_NAME=Qwen3-14B
        ;;
    *)
        echo "Usage: CUDA_VISIBLE_DEVICES=<idle-GPU-IDs> bash puhui/curriculum-opd {stage1|stage2|stage3}" >&2
        exit 2
        ;;
esac

OPD_BASE=${OPD_BASE:-/mnt/data/chenhang/ldr}
PROJECT_DIR=${PROJECT_DIR:-$OPD_BASE/projects/OPD}
OPD_ENV=${OPD_ENV:-$OPD_BASE/envs/opd-py312}
MODEL_ROOT=${MODEL_ROOT:-$OPD_BASE/models}
OPD_CACHE_ROOT=${OPD_CACHE_ROOT:-$OPD_BASE/cache/opd}
EXPERIMENT_ROOT=${EXPERIMENT_ROOT:-$OPD_BASE/experiments/OPD}

# The curriculum labels define run names. The actual model locations remain
# overridable so a verified merged checkpoint does not need to be copied into
# MODEL_ROOT before starting the next stage.
ACTOR_MODEL_PATH=${ACTOR_MODEL_PATH:-$MODEL_ROOT/$ACTOR_MODEL_NAME}
REWARD_MODEL_PATH=${REWARD_MODEL_PATH:-$MODEL_ROOT/$REWARD_MODEL_NAME}

TRAIN_DATASET=$PROJECT_DIR/datasets/dapo-math-17k.parquet
TRAIN_DATASET_NAME=DAPO-Math-17k
TEST_DATASET='["'$PROJECT_DIR'/datasets/test_data/AIME25/test.parquet","'$PROJECT_DIR'/datasets/test_data/AMC23/test.parquet","'$PROJECT_DIR'/datasets/test_data/AIME24/test.parquet"]'

# Keep these controls identical across all three curriculum stages.
MAX_PROMPT_LENGTH=${MAX_PROMPT_LENGTH:-1024}
MAX_RESP_LENGTH=${MAX_RESP_LENGTH:-15360}
MAX_VAL_RESP_LENGTH=${MAX_VAL_RESP_LENGTH:-15360}
MINI_BATCH_SIZE=${MINI_BATCH_SIZE:-32}
N_RESPONSES=${N_RESPONSES:-4}
PARALLEL_SIZE=${PARALLEL_SIZE:-1}
MODEL_DTYPE=${MODEL_DTYPE:-bfloat16}
ROLLOUT_GPU_MEMORY_UTILIZATION=${ROLLOUT_GPU_MEMORY_UTILIZATION:-0.45}
ROLLOUT_ENFORCE_EAGER=${ROLLOUT_ENFORCE_EAGER:-True}
CUDAGRAPH_CAPTURE_SIZES=${CUDAGRAPH_CAPTURE_SIZES:-null}
PPO_MAX_TOKEN_LEN_PER_GPU=${PPO_MAX_TOKEN_LEN_PER_GPU:-16384}
REWARD_MODEL_MICRO_BATCH_SIZE=${REWARD_MODEL_MICRO_BATCH_SIZE:-1}
TRAINER_N_GPUS_PER_NODE=${TRAINER_N_GPUS_PER_NODE:-4}
TRAINER_NNODES=${TRAINER_NNODES:-1}
TRAINER_SAVE_FREQ=${TRAINER_SAVE_FREQ:-40}
TRAINER_MAX_ACTOR_CKPT_TO_KEEP=${TRAINER_MAX_ACTOR_CKPT_TO_KEEP:-3}
TRAINER_MAX_CRITIC_CKPT_TO_KEEP=${TRAINER_MAX_CRITIC_CKPT_TO_KEEP:-3}
TRAINER_TEST_FREQ=${TRAINER_TEST_FREQ:--1}
TRAINER_TOTAL_EPOCHS=${TRAINER_TOTAL_EPOCHS:-2}
TRAINER_RESUME_MODE=${TRAINER_RESUME_MODE:-auto}
TRAINER_LOGGER=${TRAINER_LOGGER:-'["console","wandb"]'}
TRAINER_IS_PLOT=${TRAINER_IS_PLOT:-False}
TRAIN_MAX_SAMPLES=${TRAIN_MAX_SAMPLES:--1}
TRAINER_TOTAL_TRAINING_STEPS=${TRAINER_TOTAL_TRAINING_STEPS:-null}
EXPERIMENT_SUFFIX=${EXPERIMENT_SUFFIX:-}

if [[ ! "$TRAINER_N_GPUS_PER_NODE" =~ ^[1-9][0-9]*$ ]]; then
    echo "TRAINER_N_GPUS_PER_NODE must be a positive integer; got: $TRAINER_N_GPUS_PER_NODE" >&2
    exit 2
fi

if [[ "$SMOKE" == 1 ]]; then
    # Bound the run by complete rollout/reward/backward/optimizer steps. The
    # wrapper selects the GPU count and rollout sampling multiplicity.
    TRAIN_MAX_SAMPLES=$((SMOKE_STEPS * MINI_BATCH_SIZE))
    TRAINER_TOTAL_TRAINING_STEPS=$SMOKE_STEPS
    TRAINER_SAVE_FREQ=-1
    TRAINER_RESUME_MODE=disable
    EXPERIMENT_SUFFIX=${EXPERIMENT_SUFFIX:--smoke}
fi

TEMPERATURE=${TEMPERATURE:-0.6}
TOP_P=${TOP_P:-0.95}
GENERATION_TOP_K=${GENERATION_TOP_K:-20}
MIN_P=${MIN_P:-0.0}
TEACHER_TEMPERATURE=${TEACHER_TEMPERATURE:-1.0}
REPETITION_PENALTY=${REPETITION_PENALTY:-1.0}
LOG_PROB_TOP_K=${LOG_PROB_TOP_K:-16}
TOP_K_STRATEGY=${TOP_K_STRATEGY:-only_stu}
REWARD_WEIGHT_MODE=${REWARD_WEIGHT_MODE:-student_p}

MAX_MODEL_LEN=$((MAX_PROMPT_LENGTH + (MAX_RESP_LENGTH > MAX_VAL_RESP_LENGTH ? MAX_RESP_LENGTH : MAX_VAL_RESP_LENGTH)))
if (( PPO_MAX_TOKEN_LEN_PER_GPU < MAX_MODEL_LEN )); then
    echo "PPO_MAX_TOKEN_LEN_PER_GPU=$PPO_MAX_TOKEN_LEN_PER_GPU must be at least MAX_MODEL_LEN=$MAX_MODEL_LEN." >&2
    exit 1
fi

# Include behavior-changing settings in the default run name so auto-resume
# cannot silently mix this configuration with the earlier 4096-token run.
EXPERIMENT_NAME=${EXPERIMENT_NAME:-token_reward_direct_${TRAIN_DATASET_NAME}_curriculum-${STAGE}_${ACTOR_MODEL_NAME}_${REWARD_MODEL_NAME}_r${MAX_RESP_LENGTH}-T${TEMPERATURE}-n${N_RESPONSES}-genk${GENERATION_TOP_K}-topp${TOP_P}-opdk${LOG_PROB_TOP_K}-${TOP_K_STRATEGY}${EXPERIMENT_SUFFIX}}
CKPT_PATH=$EXPERIMENT_ROOT/checkpoints/$EXPERIMENT_NAME
VALIDATION_DIR=$EXPERIMENT_ROOT/validation/$EXPERIMENT_NAME
LOG_DIR=${LOG_DIR:-$EXPERIMENT_ROOT/logs}
WANDB_MODE=${WANDB_MODE:-online}
WANDB_DIR=${WANDB_DIR:-$OPD_CACHE_ROOT/wandb}
WANDB_PROJECT=${WANDB_PROJECT:-OnPolicyDistillation}
WANDB_RUN_ID_FILE=${WANDB_RUN_ID_FILE:-$CKPT_PATH/wandb_run_id}

if [[ -z ${CUDA_VISIBLE_DEVICES:-} ]]; then
    echo "CUDA_VISIBLE_DEVICES must explicitly list $TRAINER_N_GPUS_PER_NODE currently idle physical GPU IDs." >&2
    echo "Example: CUDA_VISIBLE_DEVICES=0,1 bash puhui/curriculum-opd-cudagraph-smoke-2xh800 $STAGE" >&2
    exit 2
fi
RUN_STAMP=$(date +%Y%m%d_%H%M%S)
RAY_TEMP_DIR=${RAY_TEMP_DIR:-$OPD_BASE/r/$STAGE}
OUTLINES_CACHE_DIR=${OUTLINES_CACHE_DIR:-$OPD_CACHE_ROOT/outlines/$EXPERIMENT_NAME-$RUN_STAMP-$$}
TMPDIR=${TMPDIR:-$OPD_BASE/t/$STAGE}

require_file() {
    if [[ ! -f "$1" ]]; then
        echo "Required file is missing: $1" >&2
        exit 1
    fi
}

require_dir() {
    if [[ ! -d "$1" ]]; then
        echo "Required directory is missing: $1" >&2
        exit 1
    fi
}

require_hf_model() {
    local model_dir=$1
    require_dir "$model_dir"
    require_file "$model_dir/config.json"
    if ! compgen -G "$model_dir/model*.safetensors" > /dev/null; then
        echo "Hugging Face model weights are missing from: $model_dir" >&2
        exit 1
    fi
}

require_dir "$PROJECT_DIR"
require_file "$OPD_ENV/bin/activate"
require_hf_model "$ACTOR_MODEL_PATH"
require_hf_model "$REWARD_MODEL_PATH"
require_file "$TRAIN_DATASET"
for task in AIME25 AMC23 AIME24; do
    require_file "$PROJECT_DIR/datasets/test_data/$task/test.parquet"
done

IFS=',' read -r -a GPU_IDS <<< "$CUDA_VISIBLE_DEVICES"
if [[ ${#GPU_IDS[@]} -ne $TRAINER_N_GPUS_PER_NODE ]]; then
    echo "CUDA_VISIBLE_DEVICES exposes ${#GPU_IDS[@]} GPUs, but TRAINER_N_GPUS_PER_NODE=$TRAINER_N_GPUS_PER_NODE" >&2
    exit 1
fi

SEEN_GPU_IDS=,
for GPU_ID in "${GPU_IDS[@]}"; do
    if [[ ! "$GPU_ID" =~ ^[0-9]+$ ]]; then
        echo "Invalid physical GPU ID: $GPU_ID" >&2
        exit 1
    fi
    if [[ "$SEEN_GPU_IDS" == *",$GPU_ID,"* ]]; then
        echo "Duplicate physical GPU ID: $GPU_ID" >&2
        exit 1
    fi
    SEEN_GPU_IDS+="$GPU_ID,"
    if ! nvidia-smi -i "$GPU_ID" --query-gpu=index --format=csv,noheader,nounits >/dev/null 2>&1; then
        echo "Physical GPU ID does not exist or is not accessible: $GPU_ID" >&2
        exit 1
    fi
done

echo "Puhui curriculum OPD configuration"
echo "  stage:         $STAGE"
echo "  smoke:         $SMOKE"
echo "  project:       $PROJECT_DIR"
echo "  environment:   $OPD_ENV"
echo "  student:       $ACTOR_MODEL_PATH"
echo "  teacher:       $REWARD_MODEL_PATH"
echo "  experiment:    $EXPERIMENT_NAME"
echo "  checkpoints:   $CKPT_PATH"
echo "  validation:    $VALIDATION_DIR"
echo "  visible GPUs:  $CUDA_VISIBLE_DEVICES"
echo "  resume mode:   $TRAINER_RESUME_MODE"
echo "  thinking:      enabled"
echo "  lengths:       prompt=$MAX_PROMPT_LENGTH, train_response=$MAX_RESP_LENGTH, val_response=$MAX_VAL_RESP_LENGTH"
echo "  sampling:      temperature=$TEMPERATURE, top_p=$TOP_P, top_k=$GENERATION_TOP_K, min_p=$MIN_P"
echo "  OPD support:   student top-$LOG_PROB_TOP_K ($TOP_K_STRATEGY), n=$N_RESPONSES"
echo "  token budget:  max_model_len=$MAX_MODEL_LEN, PPO per GPU=$PPO_MAX_TOKEN_LEN_PER_GPU"
echo "  vLLM graphs:   enforce_eager=$ROLLOUT_ENFORCE_EAGER, capture_sizes=$CUDAGRAPH_CAPTURE_SIZES"
echo "  W&B:           mode=$WANDB_MODE, project=$WANDB_PROJECT"
echo "  W&B run ID:    persisted in $WANDB_RUN_ID_FILE"
echo "  checkpoint:    every $TRAINER_SAVE_FREQ steps, keep latest $TRAINER_MAX_ACTOR_CKPT_TO_KEEP"
echo "  train samples: $TRAIN_MAX_SAMPLES"
echo "  total steps:   $TRAINER_TOTAL_TRAINING_STEPS"

if [[ ${DRY_RUN:-0} == 1 ]]; then
    echo "DRY_RUN=1: preflight completed; training was not started."
    exit 0
fi

ACTIVE_COMPUTE=""
for GPU_ID in "${GPU_IDS[@]}"; do
    GPU_PROCESSES=$(nvidia-smi -i "$GPU_ID" --query-compute-apps=pid,process_name \
        --format=csv,noheader,nounits 2>/dev/null || true)
    if [[ -n "$GPU_PROCESSES" ]]; then
        ACTIVE_COMPUTE+="GPU $GPU_ID: $GPU_PROCESSES"$'\n'
    fi
done

if [[ -n "$ACTIVE_COMPUTE" ]]; then
    echo "Refusing to start because selected GPUs already have compute processes:" >&2
    printf '%s' "$ACTIVE_COMPUTE" >&2
    exit 1
fi

mkdir -p \
    "$CKPT_PATH" \
    "$VALIDATION_DIR" \
    "$LOG_DIR" \
    "$WANDB_DIR" \
    "$OPD_CACHE_ROOT/triton" \
    "$OPD_CACHE_ROOT/torchinductor" \
    "$OPD_CACHE_ROOT/huggingface/datasets" \
    "$OPD_CACHE_ROOT/huggingface/hub" \
    "$OPD_CACHE_ROOT/flashinfer" \
    "$OPD_CACHE_ROOT/verl-rlhf" \
    "$RAY_TEMP_DIR" \
    "$OUTLINES_CACHE_DIR" \
    "$TMPDIR"

exec 9>"$EXPERIMENT_ROOT/.lock-$EXPERIMENT_NAME"
if ! flock -n 9; then
    echo "Another $EXPERIMENT_NAME launcher already holds the experiment lock." >&2
    exit 1
fi

source "$OPD_ENV/bin/activate"
cd "$PROJECT_DIR"

# Keep W&B on the same run across process interruption and checkpoint resume.
# An explicitly supplied WANDB_RUN_ID is accepted only when it matches the ID
# already associated with this experiment directory.
if [[ -s "$WANDB_RUN_ID_FILE" ]]; then
    SAVED_WANDB_RUN_ID=$(<"$WANDB_RUN_ID_FILE")
    if [[ -n ${WANDB_RUN_ID:-} && "$WANDB_RUN_ID" != "$SAVED_WANDB_RUN_ID" ]]; then
        echo "WANDB_RUN_ID=$WANDB_RUN_ID conflicts with the saved run ID $SAVED_WANDB_RUN_ID." >&2
        exit 1
    fi
    WANDB_RUN_ID=$SAVED_WANDB_RUN_ID
else
    # W&B 0.28.2 removed the legacy wandb.util.generate_id() wrapper. A run
    # ID may be supplied by the caller, or generated locally without relying
    # on W&B's private module layout.
    WANDB_RUN_ID=${WANDB_RUN_ID:-$(python -c 'import secrets; print(secrets.token_hex(4))')}
    printf '%s\n' "$WANDB_RUN_ID" > "$WANDB_RUN_ID_FILE"
fi

export CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.8}
export PATH="$OPD_ENV/bin:$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONPATH="$PROJECT_DIR/verl${PYTHONPATH:+:$PYTHONPATH}"
export CUDA_VISIBLE_DEVICES
export TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-9.0}
export TMPDIR

export HF_HOME="$OPD_CACHE_ROOT/huggingface"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_CACHE="$HF_HOME/hub"
export TRITON_CACHE_DIR="$OPD_CACHE_ROOT/triton"
export TORCHINDUCTOR_CACHE_DIR="$OPD_CACHE_ROOT/torchinductor"
export FLASHINFER_WORKSPACE_BASE="$OPD_CACHE_ROOT/flashinfer"
export OUTLINES_CACHE_DIR
export WANDB_MODE
export WANDB_DIR
export WANDB_RUN_ID
export WANDB_RESUME=${WANDB_RESUME:-allow}

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=true
export HYDRA_FULL_ERROR=1
export NCCL_DEBUG=${NCCL_DEBUG:-WARN}
export NCCL_TIMEOUT=${NCCL_TIMEOUT:-7200}
export TORCH_NCCL_BLOCKING_WAIT=1
export TORCH_DISTRIBUTED_DEBUG=${TORCH_DISTRIBUTED_DEBUG:-OFF}
export CUDA_LAUNCH_BLOCKING=${CUDA_LAUNCH_BLOCKING:-0}
export RAY_memory_usage_threshold=0.99
export RAY_DEDUP_LOGS=0

# Never attach to or stop another user's Ray cluster on this shared-root host.
# main_ppo starts a process-local Ray instance in RAY_TEMP_DIR.
unset RAY_ADDRESS

LOG_FILE="$LOG_DIR/$EXPERIMENT_NAME-$RUN_STAMP.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "Start time: $(date --iso-8601=seconds)"
echo "Log file: $LOG_FILE"
echo "W&B run: project=$WANDB_PROJECT, id=$WANDB_RUN_ID, mode=$WANDB_MODE, resume=$WANDB_RESUME"
python --version
python -m pip check
nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader

python -m verl.trainer.main_ppo \
    "algorithm.adv_estimator=token_reward_direct" \
    "algorithm.grpo_outcome_weight=1.0" \
    "data.shuffle=False" \
    "+data.cache_dir=$OPD_CACHE_ROOT/verl-rlhf" \
    "data.train_files=$TRAIN_DATASET" \
    "data.train_max_samples=$TRAIN_MAX_SAMPLES" \
    "data.val_files=$TEST_DATASET" \
    "data.train_batch_size=$MINI_BATCH_SIZE" \
    "data.max_prompt_length=$MAX_PROMPT_LENGTH" \
    "data.max_response_length=$MAX_RESP_LENGTH" \
    "data.filter_overlong_prompts=True" \
    "data.truncation=error" \
    "data.return_raw_chat=True" \
    "+data.apply_chat_template_kwargs.enable_thinking=True" \
    "actor_rollout_ref.model.path=$ACTOR_MODEL_PATH" \
    "actor_rollout_ref.model.use_remove_padding=True" \
    "actor_rollout_ref.model.enable_activation_offload=True" \
    "actor_rollout_ref.model.enable_gradient_checkpointing=True" \
    "actor_rollout_ref.actor.optim.lr=1e-6" \
    "actor_rollout_ref.actor.ppo_mini_batch_size=$MINI_BATCH_SIZE" \
    "actor_rollout_ref.actor.use_dynamic_bsz=True" \
    "actor_rollout_ref.actor.use_torch_compile=False" \
    "actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1" \
    "actor_rollout_ref.actor.ppo_max_token_len_per_gpu=$PPO_MAX_TOKEN_LEN_PER_GPU" \
    "actor_rollout_ref.actor.ulysses_sequence_parallel_size=$PARALLEL_SIZE" \
    "actor_rollout_ref.actor.entropy_from_logits_with_chunking=True" \
    "actor_rollout_ref.actor.use_kl_loss=False" \
    "actor_rollout_ref.actor.loss_agg_mode=token-mean" \
    "actor_rollout_ref.actor.fsdp_config.param_offload=False" \
    "actor_rollout_ref.actor.fsdp_config.optimizer_offload=False" \
    "actor_rollout_ref.actor.fsdp_config.forward_prefetch=True" \
    "actor_rollout_ref.actor.fsdp_config.model_dtype=$MODEL_DTYPE" \
    "actor_rollout_ref.rollout.max_num_batched_tokens=$PPO_MAX_TOKEN_LEN_PER_GPU" \
    "actor_rollout_ref.ref.fsdp_config.param_offload=True" \
    "actor_rollout_ref.ref.fsdp_config.model_dtype=$MODEL_DTYPE" \
    "actor_rollout_ref.ref.log_prob_use_dynamic_bsz=True" \
    "actor_rollout_ref.rollout.name=vllm" \
    "actor_rollout_ref.rollout.enforce_eager=$ROLLOUT_ENFORCE_EAGER" \
    "actor_rollout_ref.rollout.cudagraph_capture_sizes=$CUDAGRAPH_CAPTURE_SIZES" \
    "actor_rollout_ref.rollout.temperature=$TEMPERATURE" \
    "actor_rollout_ref.rollout.top_p=$TOP_P" \
    "actor_rollout_ref.rollout.top_k=$GENERATION_TOP_K" \
    "+actor_rollout_ref.rollout.min_p=$MIN_P" \
    "actor_rollout_ref.rollout.log_prob_use_dynamic_bsz=True" \
    "+actor_rollout_ref.rollout.log_prob_top_k=$LOG_PROB_TOP_K" \
    "+actor_rollout_ref.rollout.top_k_strategy=$TOP_K_STRATEGY" \
    "+actor_rollout_ref.rollout.reward_weight_mode=$REWARD_WEIGHT_MODE" \
    "+actor_rollout_ref.rollout.teacher_temperature=$TEACHER_TEMPERATURE" \
    "actor_rollout_ref.rollout.tensor_model_parallel_size=$PARALLEL_SIZE" \
    "actor_rollout_ref.rollout.gpu_memory_utilization=$ROLLOUT_GPU_MEMORY_UTILIZATION" \
    "actor_rollout_ref.rollout.max_model_len=$MAX_MODEL_LEN" \
    "actor_rollout_ref.rollout.n=$N_RESPONSES" \
    "actor_rollout_ref.rollout.val_kwargs.do_sample=True" \
    "+actor_rollout_ref.rollout.val_kwargs.max_tokens=$MAX_VAL_RESP_LENGTH" \
    "actor_rollout_ref.rollout.val_kwargs.n=16" \
    "actor_rollout_ref.rollout.val_kwargs.temperature=0.7" \
    "actor_rollout_ref.rollout.val_kwargs.top_p=0.95" \
    "actor_rollout_ref.rollout.repetition_penalty=$REPETITION_PENALTY" \
    "actor_rollout_ref.rollout.calculate_log_probs=True" \
    "actor_rollout_ref.ref.log_prob_micro_batch_size_per_gpu=1" \
    "reward_model.enable=True" \
    "+reward_model.reward_kwargs.enable_format_reward=False" \
    "reward_model.model.path=$REWARD_MODEL_PATH" \
    "reward_model.model.input_tokenizer=null" \
    "reward_model.model.use_remove_padding=True" \
    "reward_model.model.fsdp_config.param_offload=False" \
    "+reward_model.model.dtype=$MODEL_DTYPE" \
    "reward_model.micro_batch_size_per_gpu=$REWARD_MODEL_MICRO_BATCH_SIZE" \
    "custom_reward_function.path=$PROJECT_DIR/verl/verl/utils/reward_score/ttrl_math/__init__.py" \
    "custom_reward_function.name=reward_func" \
    "trainer.val_before_train=False" \
    "trainer.log_val_generations=2" \
    "trainer.logger=$TRAINER_LOGGER" \
    "trainer.project_name=$WANDB_PROJECT" \
    "trainer.experiment_name=$EXPERIMENT_NAME" \
    "trainer.validation_data_dir=$VALIDATION_DIR" \
    "trainer.n_gpus_per_node=$TRAINER_N_GPUS_PER_NODE" \
    "trainer.nnodes=$TRAINER_NNODES" \
    "trainer.save_freq=$TRAINER_SAVE_FREQ" \
    "trainer.max_actor_ckpt_to_keep=$TRAINER_MAX_ACTOR_CKPT_TO_KEEP" \
    "trainer.max_critic_ckpt_to_keep=$TRAINER_MAX_CRITIC_CKPT_TO_KEEP" \
    "trainer.test_freq=$TRAINER_TEST_FREQ" \
    "trainer.total_epochs=$TRAINER_TOTAL_EPOCHS" \
    "trainer.total_training_steps=$TRAINER_TOTAL_TRAINING_STEPS" \
    "trainer.default_local_dir=$CKPT_PATH" \
    "trainer.resume_mode=$TRAINER_RESUME_MODE" \
    "trainer.resume_from_path=null" \
    "trainer.is_plot=$TRAINER_IS_PLOT" \
    "ray_kwargs.ray_init.num_cpus=64" \
    "+ray_kwargs.ray_init._temp_dir=$RAY_TEMP_DIR"

echo "End time: $(date --iso-8601=seconds)"
