#!/usr/bin/env bash
# Fixed AIME24/AIME25/AMC23 questions; final Stage 1/2/3 students score against
# their respective 4B/8B/14B teachers. Forward-only, one explicitly selected GPU.
# From the repository root on puhui:
#   CUDA_VISIBLE_DEVICES=<idle-GPU-ID> bash puhui/eval-curriculum-overlap
#   DRY_RUN=1 bash puhui/eval-curriculum-overlap
# Existing output directories are never reused or overwritten. For a repeat run
# choose a new OVERLAP_OUTPUT_ROOT. Same data files + seed select the same rows.
# Outputs include summary_chunks.md/csv/json using the original 1024-response-
# token bins, plus per_question_chunks.json, per-token arrays, and a
# mechanism-analysis directory containing sparse-union cosine and log-prob gaps.
# SCORE_CHUNK_SIZE controls forward-pass memory only; it does not change the
# diagnostic bins.
# Requires the same OPD environment as eval-qwen3-1p7b-opd, with transformers,
# pandas/pyarrow and vLLM. Does not submit training, merge models, or stop Ray.
set -euo pipefail

OPD_BASE=${OPD_BASE:-/mnt/data/chenhang/ldr}
PROJECT_DIR=${PROJECT_DIR:-$OPD_BASE/projects/OPD}
OPD_ENV=${OPD_ENV:-$OPD_BASE/envs/opd-py312}
MODEL_ROOT=${MODEL_ROOT:-$OPD_BASE/models}
OPD_CACHE_ROOT=${OPD_CACHE_ROOT:-$OPD_BASE/cache/opd}
EXPERIMENT_ROOT=${EXPERIMENT_ROOT:-$OPD_BASE/experiments/OPD}
DATA_DIR=${DATA_DIR:-$PROJECT_DIR/scripts/val/data}
STAGE1_MODEL_PATH=${STAGE1_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B}
STAGE2_MODEL_PATH=${STAGE2_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B-8B}
STAGE3_MODEL_PATH=${STAGE3_MODEL_PATH:-$MODEL_ROOT/Qwen3-1.7B-OPD-4B-8B-14B}
TEACHER4B_PATH=${TEACHER4B_PATH:-$MODEL_ROOT/Qwen3-4B}
TEACHER8B_PATH=${TEACHER8B_PATH:-$MODEL_ROOT/Qwen3-8B}
TEACHER14B_PATH=${TEACHER14B_PATH:-$MODEL_ROOT/Qwen3-14B}
QUESTIONS_PER_TASK=${QUESTIONS_PER_TASK:-5}
SAMPLES_PER_QUESTION=${SAMPLES_PER_QUESTION:-1}
SEED=${SEED:-42}
# Match current puhui/eval-qwen3-1p7b-opd generation settings, not training length.
MAX_TOKENS=${MAX_TOKENS:-38912}
TEMPERATURE=${TEMPERATURE:-0.7}
TOP_P=${TOP_P:-0.8}
GENERATION_TOP_K=${GENERATION_TOP_K:-20}
SCORE_CHUNK_SIZE=${SCORE_CHUNK_SIZE:-128}
ENABLE_THINKING=${ENABLE_THINKING:-0}
case "$ENABLE_THINKING" in
    1|true|True|TRUE) THINKING_LABEL=thinking ;;
    0|false|False|FALSE) THINKING_LABEL=nonthinking ;;
    *)
        echo "ENABLE_THINKING must be one of: 1, true, 0, false; got: $ENABLE_THINKING" >&2
        exit 2
        ;;
esac
OVERLAP_OUTPUT_ROOT=${OVERLAP_OUTPUT_ROOT:-$EXPERIMENT_ROOT/evaluation/curriculum-overlap-fixed-$THINKING_LABEL}

if [[ ! -f "$OPD_ENV/bin/activate" ]]; then
    echo "Missing OPD environment: $OPD_ENV/bin/activate" >&2
    exit 1
fi
if [[ -e "$OVERLAP_OUTPUT_ROOT" ]]; then
    echo "Output already exists; select a new OVERLAP_OUTPUT_ROOT: $OVERLAP_OUTPUT_ROOT" >&2
    exit 1
fi
source "$OPD_ENV/bin/activate"
export CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.8}
export PATH="$OPD_ENV/bin:$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export HF_HOME="$OPD_CACHE_ROOT/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export TRITON_CACHE_DIR="$OPD_CACHE_ROOT/triton"
export TORCHINDUCTOR_CACHE_DIR="$OPD_CACHE_ROOT/torchinductor"
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1

ARGS=(
    --pair "stage1=$STAGE1_MODEL_PATH,$TEACHER4B_PATH"
    --pair "stage2=$STAGE2_MODEL_PATH,$TEACHER8B_PATH"
    --pair "stage3=$STAGE3_MODEL_PATH,$TEACHER14B_PATH"
    --data-dir "$DATA_DIR" --output-root "$OVERLAP_OUTPUT_ROOT"
    --questions-per-task "$QUESTIONS_PER_TASK" --samples-per-question "$SAMPLES_PER_QUESTION" --seed "$SEED"
    --max-tokens "$MAX_TOKENS" --temperature "$TEMPERATURE" --top-p "$TOP_P"
    --generation-top-k "$GENERATION_TOP_K" --ks 4 8 16
    --score-chunk-size "$SCORE_CHUNK_SIZE"
)
if [[ "$THINKING_LABEL" == thinking ]]; then
    ARGS+=(--enable-thinking)
fi
if [[ ${DRY_RUN:-0} == 1 ]]; then
    exec python "$PROJECT_DIR/scripts/val/eval/eval_fixed_overlap.py" "${ARGS[@]}" --dry-run
fi
if [[ ! ${CUDA_VISIBLE_DEVICES:-} =~ ^[0-9]+$ ]]; then
    echo "Set CUDA_VISIBLE_DEVICES to one explicitly selected idle physical GPU ID." >&2
    exit 2
fi
nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
# Fail closed if GPU process inspection fails.
GPU_PROCESSES=$(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-compute-apps=pid,process_name --format=csv,noheader,nounits)
if [[ -n "$GPU_PROCESSES" ]]; then
    echo "GPU $CUDA_VISIBLE_DEVICES has compute processes; refusing to start:" >&2
    printf '%s\n' "$GPU_PROCESSES" >&2
    exit 1
fi
export TMPDIR=${TMPDIR:-$OPD_BASE/tmp/overlap-$$}
export OUTLINES_CACHE_DIR="$OPD_CACHE_ROOT/outlines/overlap-$$"
mkdir -p "$TMPDIR" "$OUTLINES_CACHE_DIR" "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR"
python -m pip check
exec python "$PROJECT_DIR/scripts/val/eval/eval_fixed_overlap.py" "${ARGS[@]}"
