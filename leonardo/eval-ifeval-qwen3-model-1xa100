#!/usr/bin/env bash
# Submit the independent IFEval generation and rule-scoring pipeline on one
# Leonardo A100. The standard protocol is non-thinking, zero-shot, greedy,
# n=1, max_tokens=4096.
#
# Usage on a Leonardo login node:
#   MODEL_NAME=... MODEL_PATH=/absolute/model/path \
#     bash leonardo/eval-ifeval-qwen3-model-1xa100
#
# Preflight without submitting:
#   MODEL_NAME=... MODEL_PATH=/absolute/model/path DRY_RUN=1 \
#     bash leonardo/eval-ifeval-qwen3-model-1xa100

#SBATCH --job-name=eval-ifeval
#SBATCH --account=EUHPC_D33_157
#SBATCH --partition=boost_usr_prod
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=120G
#SBATCH --time=24:00:00

set -euo pipefail

PROJECT_DIR=${PROJECT_DIR:-/leonardo_work/EUHPC_D33_157/OPD-experiment/OPD}
CONDA_BASE=${CONDA_BASE:-/leonardo/home/userexternal/jbi00000/miniconda3}
CONDA_ENV=${CONDA_ENV:-/leonardo_work/EUHPC_D33_157/jbi00000/conda_envs/opd-cu118}
OPD_CACHE_ROOT=${OPD_CACHE_ROOT:-/leonardo_work/EUHPC_D33_157/OPD-experiment/.cache/opd}
IFEVAL_DEPS_DIR=${IFEVAL_DEPS_DIR:-$OPD_CACHE_ROOT/ifeval-scorer-py312}
NLTK_DATA=${NLTK_DATA:-$OPD_CACHE_ROOT/nltk-ifeval}

if [[ -z ${MODEL_NAME:-} || -z ${MODEL_PATH:-} ]]; then
    echo "Set both MODEL_NAME and the absolute MODEL_PATH for the model to evaluate." >&2
    exit 2
fi
if [[ "$MODEL_PATH" != /* ]]; then
    echo "MODEL_PATH must be absolute; got: $MODEL_PATH" >&2
    exit 2
fi

ENABLE_THINKING=${ENABLE_THINKING:-0}
NUM_SAMPLES=${NUM_SAMPLES:-1}
TEMPERATURE=${TEMPERATURE:-0.0}
TOP_P=${TOP_P:-1.0}
TOP_K=${TOP_K:--1}
MIN_P=${MIN_P:-0.0}
MAX_TOKENS=${MAX_TOKENS:-4096}
SEED=${SEED:-0}
MAX_EXAMPLES=${MAX_EXAMPLES:-}
EVAL_OVERWRITE=${EVAL_OVERWRITE:-0}
GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.9}
DTYPE=${DTYPE:-auto}
EVAL_OUTPUT_ROOT=${EVAL_OUTPUT_ROOT:-$PROJECT_DIR/scripts/val/eval/justrl_eval_outputs/ifeval}
EVAL_JOB_NAME=${EVAL_JOB_NAME:-eval-ifeval}
EVAL_TIME_LIMIT=${EVAL_TIME_LIMIT:-24:00:00}
LOG_DIR=${LOG_DIR:-$PROJECT_DIR/logs}
DRY_RUN=${DRY_RUN:-0}

case "$ENABLE_THINKING" in
    0|1) ;;
    *)
        echo "ENABLE_THINKING must be 0 or 1; got: $ENABLE_THINKING" >&2
        exit 2
        ;;
esac
case "$EVAL_OVERWRITE" in
    0|1) ;;
    *)
        echo "EVAL_OVERWRITE must be 0 or 1; got: $EVAL_OVERWRITE" >&2
        exit 2
        ;;
esac
case "$DRY_RUN" in
    0|1) ;;
    *)
        echo "DRY_RUN must be 0 or 1; got: $DRY_RUN" >&2
        exit 2
        ;;
esac
if [[ ! "$NUM_SAMPLES" =~ ^[1-9][0-9]*$ ]]; then
    echo "NUM_SAMPLES must be a positive integer; got: $NUM_SAMPLES" >&2
    exit 2
fi
if [[ ! "$MAX_TOKENS" =~ ^[1-9][0-9]*$ ]]; then
    echo "MAX_TOKENS must be a positive integer; got: $MAX_TOKENS" >&2
    exit 2
fi
if [[ ! "$SEED" =~ ^[0-9]+$ ]]; then
    echo "SEED must be a non-negative integer; got: $SEED" >&2
    exit 2
fi
if [[ -n "$MAX_EXAMPLES" && ! "$MAX_EXAMPLES" =~ ^[1-9][0-9]*$ ]]; then
    echo "MAX_EXAMPLES must be empty or a positive integer; got: $MAX_EXAMPLES" >&2
    exit 2
fi

require_file() {
    if [[ ! -f "$1" ]]; then
        echo "Required file is missing: $1" >&2
        exit 1
    fi
}

require_dir() {
    if [[ ! -d "$1" ]]; then
        echo "Required directory is missing: $1" >&2
        exit 1
    fi
}

require_dir "$PROJECT_DIR"
require_dir "$MODEL_PATH"
require_dir "$IFEVAL_DEPS_DIR"
require_file "$MODEL_PATH/config.json"
if ! compgen -G "$MODEL_PATH/model*.safetensors" >/dev/null; then
    echo "Hugging Face model weights are missing from: $MODEL_PATH" >&2
    exit 1
fi
require_file "$PROJECT_DIR/scripts/val/data/IFEval/ifeval_input_data.jsonl"
require_file "$PROJECT_DIR/scripts/val/eval/eval_ifeval.py"
require_file "$PROJECT_DIR/scripts/val/eval/grade_ifeval.py"
require_dir "$PROJECT_DIR/scripts/val/eval/ifeval_scorer"
require_dir "$NLTK_DATA/tokenizers/punkt_tab"

PYTHONPATH="$IFEVAL_DEPS_DIR:$PROJECT_DIR/scripts/val/eval:$PROJECT_DIR/verl${PYTHONPATH:+:$PYTHONPATH}" \
    NLTK_DATA="$NLTK_DATA" \
    "$CONDA_ENV/bin/python" -c "import grade_ifeval; grade_ifeval.validate_scorer_environment()"

echo "Leonardo IFEval configuration"
echo "  model name:      $MODEL_NAME"
echo "  model path:      $MODEL_PATH"
echo "  output root:     $EVAL_OUTPUT_ROOT"
echo "  thinking:        $ENABLE_THINKING"
echo "  zero-shot:       true"
echo "  samples:         $NUM_SAMPLES"
echo "  max examples:    ${MAX_EXAMPLES:-all}"
echo "  sampling:        temperature=$TEMPERATURE, top_p=$TOP_P, top_k=$TOP_K, min_p=$MIN_P"
echo "  seed:            $SEED"
echo "  max tokens:      $MAX_TOKENS"
echo "  overwrite:       $EVAL_OVERWRITE"
echo "  scorer packages: $IFEVAL_DEPS_DIR"
echo "  NLTK data:       $NLTK_DATA"
echo "  Slurm resources: 1 x A100, 8 CPUs, 120G RAM, time=$EVAL_TIME_LIMIT"

if [[ "$DRY_RUN" == 1 ]]; then
    echo "DRY_RUN=1: configuration checked; no Slurm job was submitted."
    exit 0
fi

if [[ -z ${SLURM_JOB_ID:-} ]]; then
    mkdir -p "$LOG_DIR"
    export PROJECT_DIR CONDA_BASE CONDA_ENV OPD_CACHE_ROOT IFEVAL_DEPS_DIR NLTK_DATA
    export MODEL_NAME MODEL_PATH ENABLE_THINKING NUM_SAMPLES TEMPERATURE TOP_P TOP_K MIN_P
    export MAX_TOKENS SEED MAX_EXAMPLES EVAL_OVERWRITE GPU_MEMORY_UTILIZATION DTYPE
    export EVAL_OUTPUT_ROOT EVAL_JOB_NAME EVAL_TIME_LIMIT LOG_DIR
    SCRIPT_PATH=$(realpath "$0")
    exec sbatch \
        --job-name="$EVAL_JOB_NAME" \
        --time="$EVAL_TIME_LIMIT" \
        --export=ALL \
        --output="$LOG_DIR/%x-%j.out" \
        --error="$LOG_DIR/%x-%j.err" \
        "$SCRIPT_PATH"
fi

set +u
source "$CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"
set -u
cd "$PROJECT_DIR"

export PYTHONPATH="$IFEVAL_DEPS_DIR:$PROJECT_DIR/verl${PYTHONPATH:+:$PYTHONPATH}"
export HF_HOME=${HF_HOME:-$OPD_CACHE_ROOT/huggingface}
export HF_DATASETS_CACHE=${HF_DATASETS_CACHE:-$HF_HOME/datasets}
export HF_HUB_CACHE=${HF_HUB_CACHE:-$HF_HOME/hub}
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$OPD_CACHE_ROOT/triton}
export TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$OPD_CACHE_ROOT/torchinductor}
export OUTLINES_CACHE_DIR=${OUTLINES_CACHE_DIR:-$OPD_CACHE_ROOT/outlines/ifeval-$MODEL_NAME-$SLURM_JOB_ID}
export TMPDIR=${TMPDIR:-$OPD_CACHE_ROOT/tmp/ifeval-$SLURM_JOB_ID}
export NLTK_DATA
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=true
unset ROCR_VISIBLE_DEVICES

mkdir -p \
    "$EVAL_OUTPUT_ROOT" \
    "$LOG_DIR" \
    "$HF_DATASETS_CACHE" \
    "$HF_HUB_CACHE" \
    "$TRITON_CACHE_DIR" \
    "$TORCHINDUCTOR_CACHE_DIR" \
    "$OUTLINES_CACHE_DIR" \
    "$TMPDIR"

python --version
python -m pip check
(
    cd "$PROJECT_DIR/scripts/val/eval"
    python -c "import grade_ifeval; grade_ifeval.validate_scorer_environment()"
)
nvidia-smi --query-gpu=index,name,memory.total,memory.used,utilization.gpu --format=csv,noheader

EVAL_ARGS=(
    --model-name "$MODEL_NAME"
    --model-path "$MODEL_PATH"
    --data-file "$PROJECT_DIR/scripts/val/data/IFEval/ifeval_input_data.jsonl"
    --output-root "$EVAL_OUTPUT_ROOT"
    --gpu-ids 0
    --tensor-parallel-size 1
    --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION"
    --dtype "$DTYPE"
    --num-samples "$NUM_SAMPLES"
    --temperature "$TEMPERATURE"
    --top-p "$TOP_P"
    --top-k "$TOP_K"
    --min-p "$MIN_P"
    --max-tokens "$MAX_TOKENS"
    --seed "$SEED"
)
if [[ "$ENABLE_THINKING" == 1 ]]; then
    EVAL_ARGS+=(--enable-thinking)
fi
if [[ -n "$MAX_EXAMPLES" ]]; then
    EVAL_ARGS+=(--max-examples "$MAX_EXAMPLES")
fi
if [[ "$EVAL_OVERWRITE" == 1 ]]; then
    EVAL_ARGS+=(--overwrite)
fi

echo "Start time: $(date --iso-8601=seconds)"
python scripts/val/eval/eval_ifeval.py "${EVAL_ARGS[@]}"
echo "End time: $(date --iso-8601=seconds)"
echo "IFEval results: $EVAL_OUTPUT_ROOT/$MODEL_NAME"
